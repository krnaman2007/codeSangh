// server/prisma/schema.prisma
// DevSync Database Schema (Neon PostgreSQL + Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  editor
  viewer
}

enum NodeType {
  folder
  file
}

// 5.1 users (Blueprint Section 5.1)
model User {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(50)
  email         String          @unique @db.VarChar(254) // lowercase in zod: .toLowerCase()
  passwordHash  String          @map("password_hash")
  avatarColor   String          @map("avatar_color") @db.VarChar(7)
  preferences   Json            @default("{\"aiSuggestions\":true,\"suggestionDelayMs\":400}")
  lastLoginAt   DateTime?       @map("last_login_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  sessions      Session[]
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[] @relation("MemberUser")
  invitesSent   ProjectMember[] @relation("MemberInviter")
  nodesCreated  FileNode[]      @relation("NodeCreator")
  nodesModified FileNode[]      @relation("NodeModifier")
  executions    Execution[]     @relation("UserExecutions")

  @@map("users")
}

// 5.2 sessions / refresh tokens (Blueprint Section 5.2)
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent")
  ip         String?   // was INET
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// 5.3 projects (Blueprint Section 5.3)
model Project {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String          @db.VarChar(100)
  nameLower  String          @map("name_lower") @db.VarChar(100) // set in repository: name.toLowerCase()
  ownerId    String          @map("owner_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  nodes      FileNode[]
  executions Execution[]

  @@unique([ownerId, nameLower])
  @@index([ownerId])
  @@map("projects")
}

// 5.4 project_members (Blueprint Section 5.4)
model ProjectMember {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole
  invitedById String     @map("invited_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User       @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User       @relation("MemberInviter", fields: [invitedById], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// 5.5 file_nodes (Blueprint Section 5.5)
model FileNode {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  parentId         String?     @map("parent_id") @db.Uuid
  type             NodeType
  name             String      @db.VarChar(100)
  nameLower        String      @map("name_lower") @db.VarChar(100)
  language         String?     @db.VarChar(20)
  content          String      @default("")
  yjsState         Bytes?      @map("yjs_state")
  size             Int         @default(0)
  createdById      String?     @map("created_by") @db.Uuid
  lastModifiedById String?     @map("last_modified_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent           FileNode?   @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children         FileNode[]  @relation("NodeTree")
  createdBy        User?       @relation("NodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastModifiedBy   User?       @relation("NodeModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)
  executions       Execution[]

  @@index([projectId])
  @@index([parentId])
  @@map("file_nodes")
}

// 5.6 executions (Blueprint Section 5.6)
model Execution {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String    @map("project_id") @db.Uuid
  fileId        String?   @map("file_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  language      String    @db.VarChar(20)
  status        String    @db.VarChar(50) // 'success' | 'error' | 'timeout' | 'compilation_error'
  stdout        String?
  stderr        String?
  compileOutput String?   @map("compile_output")
  time          Float?
  memory        Int?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file          FileNode? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  user          User      @relation("UserExecutions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@map("executions")
}
