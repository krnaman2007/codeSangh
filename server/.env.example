# ---- Server Environment Variables (Blueprint Section 4.1) ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Neon PostgreSQL (Prisma) ----
# Pooled connection string (host has -pooler, pgbouncer=true) for runtime queries
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.neon.tech/devsync?sslmode=require&pgbouncer=true

# Direct connection string (unpooled) for migrations
DIRECT_URL=postgresql://USER:PASS@ep-xxx.neon.tech/devsync?sslmode=require

# ---- Authentication & Security (Blueprint Section 4.1 & 6.1) ----
JWT_ACCESS_SECRET=change-me-long-random-secret-key
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12

# ---- Code Execution (Judge0 API - Section 4.1 & 8.0) ----
# Optional in dev (falls back to safe sandbox simulation). Set key for live Judge0 execution.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
