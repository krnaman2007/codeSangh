# Client Environment Variables
# Base path or URL for REST API calls (defaults to /api/v1 via Vite dev proxy)
VITE_API_BASE_URL=/api/v1

# Optional explicit Socket.IO origin (defaults to current window origin via Vite proxy)
VITE_SOCKET_URL=

# Dev-only proxy target for /api and /socket.io
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Optional Gemini / App URL metadata
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
