# ---- Server Environment Variables ----
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---- Neon PostgreSQL (Prisma) ----
# Pooled connection string (host has -pooler, pgbouncer=true) for runtime queries
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.neon.tech/devsync?sslmode=require&pgbouncer=true

# Direct connection string (unpooled) for migrations
DIRECT_URL=postgresql://USER:PASS@ep-xxx.neon.tech/devsync?sslmode=require
